pipeline {

  agent { label 'kubectl' }
  // Run the pipeline on an agent with kubectl available.

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '25'))
    timeout(time: 20, unit: 'MINUTES')
    skipDefaultCheckout(true)
    // Add timestamps, prevent concurrent runs, retain the last 25 builds,
    // enforce a 20-minute timeout, and handle SCM checkout explicitly.
  }

  parameters {
    string(
      name: 'IMAGE',
      defaultValue: '',
      description: 'Required immutable image reference, for example registry.example/app@sha256:…'
    )
    // Image to deploy; production requires it to be pinned to a SHA256 digest.
  }

  stages {

    stage('Checkout') {
      steps {
        checkout scm
        // Checks out the source code from the repository: This gives Jenkins access to the Jenkinsfile and Kubernetes manifests.
      }
    }
    // Runs Kustomize against the Kubernetes manifests.
    // Kustomize combines the base manifests and overlays into the final Kubernetes YAML- The resulting YAML is written to "rendered.yaml".
    // Nothing has been deployed yet; this stage below only generates the final configuration.
    stage('Validate manifests') {
      steps {
        sh 'kubectl kustomize Jenkins-cd-k8s/manifests > rendered.yaml'
        sh 'test -s rendered.yaml'
        // Summary: Render the Kustomize manifests and verify the output is non-empty.
      }
    }

    stage('Require immutable image') {
      when { branch 'main' }
      // Only performs this check when the pipeline is running from the "main" branch. 
      // Production deployment is therefore restricted to main.

      steps {
        script {
          if (!params.IMAGE?.trim() || !(params.IMAGE ==~ /.+@sha256:[a-f0-9]{64}/)) {
            error('Deployments require IMAGE to be pinned by sha256 digest.')
          }
          // Reject production deployments without a valid SHA256-pinned image.
        }
      }
    }

    stage('Production approval') {
      when { branch 'main' }
      // Only prompts for approval when the pipeline is running from the "main" branch.
      input {
        message "Approve production rollout of ${params.IMAGE}?"
        ok 'Deploy to production'
        submitter 'release-managers'
        // Display the image being deployed and restrict approval to release-managers.
      }

      steps {
        echo 'Production deployment approved.'
      }
    }

    stage('Production rollout') {
      when { branch 'main' }
      // Execute the production rollout only from main.

      steps {
        withCredentials([file(credentialsId: 'kubeconfig-prod', variable: 'KUBECONFIG')]) {
          // Inject the production kubeconfig only for the deployment step.

          sh '''#!/usr/bin/env bash
            set -Eeuo pipefail
            // Fail fast on command, unset-variable, and pipeline errors.

            sed "s#IMAGE_PLACEHOLDER#$IMAGE#g" rendered.yaml | kubectl apply -f -
            // Inject the immutable image reference and apply the rendered manifests.

            kubectl rollout status deployment/app
              -n production
              --timeout=180s
            // Wait up to three minutes for the production deployment to complete.
          '''
        }
      }
    }
  }

  post {

    always {
      archiveArtifacts artifacts: 'rendered.yaml', allowEmptyArchive: true
      // Preserve the rendered manifest (for troubleshooting and deployment auditing).
    }

    failure {
      echo 'Rollout failed; inspect deployment events and use the cluster rollback procedure.'
      // Point operators to the Kubernetes investigation and rollback procedure.
    }
  }
}